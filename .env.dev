# Dev-mode env. `make up` copies this to .env if you don't have one.
# Never ship these values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafetone

APP_JWT_SECRET=dev-secret-never-use-in-production-at-least-32-bytes

BAR_NAME=Cafetone
BAR_SHORT_NAME=Cafetone
STAMPS_REQUIRED=10
REWARD_TEXT=Free coffee

# Swallow 5-minute cooldown so we can stamp in a loop for tests.
STAMP_COOLDOWN_SECONDS=0

# Turn on the in-browser wallet simulator. Skips all Apple/Google API calls.
DEV_MOCK_WALLETS=true

# In dev we log emails to stdout instead of calling Postmark.
POSTMARK_TOKEN=
EMAIL_FROM=dev@example.com

PASS_QR_JWT_TTL_SECONDS=300
STAFF_SESSION_DAYS=30
