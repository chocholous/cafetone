# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://loyalty.example.com

# ─── Postgres ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafetone

# ─── Secrets ──────────────────────────────────────────────────────────────
# Signs pass QR JWTs + staff session cookies. 32+ random bytes, base64.
APP_JWT_SECRET=replace_me_with_openssl_rand_base64_48

# ─── Brand / bar ──────────────────────────────────────────────────────────
BAR_NAME=Cafetone
BAR_SHORT_NAME=Cafetone
STAMPS_REQUIRED=10
REWARD_TEXT=Free coffee of your choice

# ─── Apple Wallet ─────────────────────────────────────────────────────────
# Pass Type Identifier registered in Apple Developer portal.
APPLE_PASS_TYPE_ID=pass.com.example.cafetone
APPLE_TEAM_ID=ABCDE12345
APPLE_ORG_NAME=Cafetone
# Paths to signing certificates (see README for generation).
APPLE_SIGNER_CERT_PATH=secrets/pass-cert.pem
APPLE_SIGNER_KEY_PATH=secrets/pass-key.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=secrets/apple-wwdr.pem
# APNs auth key (.p8) for wallet push notifications.
APPLE_APNS_KEY_PATH=secrets/apns-authkey.p8
APPLE_APNS_KEY_ID=ABC123DEFG
APPLE_APNS_TEAM_ID=ABCDE12345

# ─── Google Wallet ────────────────────────────────────────────────────────
# Issuer ID from Google Pay & Wallet Console (requires approval).
GOOGLE_ISSUER_ID=3388000000022000000
GOOGLE_CLASS_ID_SUFFIX=cafetone_stamp_card_v1
# Path to the Wallet API service-account JSON.
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/google-service-account.json

# ─── Email (magic links) ──────────────────────────────────────────────────
# Postmark server token, or leave blank to log to console in dev.
POSTMARK_TOKEN=
EMAIL_FROM=loyalty@example.com

# ─── Security ─────────────────────────────────────────────────────────────
# Minimum seconds between stamps for the same customer.
STAMP_COOLDOWN_SECONDS=300
# Wallet-pass QR JWT lifetime.
PASS_QR_JWT_TTL_SECONDS=300
# Staff session cookie lifetime (days).
STAFF_SESSION_DAYS=30
